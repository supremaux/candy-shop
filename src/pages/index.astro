---
import "../../src/styles/global.css";
import {
  Candy,
  Search,
  MapPin,
  Truck,
  SearchX,
  MessageCircle,
  Eye,
  Rocket,
} from "@lucide/astro";

const title = "Candy Shop";
---

<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-gray-50 font-sans text-gray-800 antialiased min-h-screen">
    <!-- ==================== HEADER ==================== -->
    <header
      class="sticky top-0 z-40 bg-white shadow-sm border-b border-gray-100"
    >
      <div class="max-w-6xl mx-auto px-4 py-3">
        <!-- Linha 1: Logo + Localização (mobile) / Tudo em linha (desktop) -->
        <div
          class="flex items-center justify-between gap-3 flex-wrap md:flex-nowrap"
        >
          <!-- Logo -->
          <a
            href="#"
            class="flex items-center gap-2 flex-shrink-0"
            aria-label="Candy Shop — Página Inicial"
          >
            <div
              class="w-9 h-9 bg-red-600 rounded-lg flex items-center justify-center"
            >
              <Candy class="w-5 h-5 text-white" />
            </div>
            <div class="leading-tight">
              <span class="font-bold text-lg text-gray-900 tracking-tight"
                >Candy Shop</span
              >
              <span class="block text-[10px] text-red-600 font-medium -mt-0.5"
                >Atacado & Varejo</span
              >
            </div>
          </a>

          <!-- Barra de busca (oculta em mobile muito pequeno, visível a partir de sm) -->
          <div
            class="relative flex-1 min-w-0 max-w-md hidden sm:block order-3 md:order-2 w-full md:w-auto mt-2 md:mt-0"
          >
            <div class="relative">
              <Search
                class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none"
              />
              <input
                type="text"
                id="searchInput"
                placeholder="Buscar produtos..."
                class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-gray-100 border border-transparent focus:border-brand-300 focus:bg-white focus:ring-2 focus:ring-brand-100 text-sm text-gray-700 placeholder-gray-400 transition-all duration-200 outline-none"
                autocomplete="off"
              />
            </div>
          </div>

          <!-- Localização -->
          <div
            class="flex items-center gap-1.5 text-sm text-gray-600 flex-shrink-0 cursor-pointer hover:text-brand-600 transition-colors order-2 md:order-3"
            title="Nossa localização"
          >
            <MapPin class="w-4 h-4 text-brand-500" />
            <span class="font-medium hidden sm:inline">Campo Grande, MS</span>
            <span class="font-medium sm:hidden text-xs">CG, MS</span>
          </div>
        </div>

        <!-- Barra de busca mobile (visível apenas em telas muito pequenas) -->
        <div class="mt-2 sm:hidden">
          <div class="relative">
            <Search
              class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none"
            />
            <input
              type="text"
              id="searchInputMobile"
              placeholder="Buscar produtos..."
              class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-gray-100 border border-transparent focus:border-brand-300 focus:bg-white focus:ring-2 focus:ring-brand-100 text-sm text-gray-700 placeholder-gray-400 transition-all duration-200 outline-none"
              autocomplete="off"
            />
          </div>
        </div>
      </div>
    </header>

    <!-- ==================== BANNER PROMOCIONAL SUTIL ==================== -->
    <div class="bg-red-600 text-white">
      <div
        class="max-w-6xl mx-auto px-4 py-2.5 flex items-center justify-center gap-2 text-sm font-medium"
      >
        <Truck class="w-4 h-4" />
        <span
          >Frete grátis a partir de R$ 199 • Descontos exclusivos no atacado</span
        >
      </div>
    </div>

    <!-- ==================== CATEGORIAS (PILLS HORIZONTAIS) ==================== -->
    <div
      class="bg-white border-b border-gray-100 sticky top-[72px] md:top-[76px] z-30 shadow-sm"
    >
      <div class="max-w-6xl mx-auto px-4 py-3">
        <div
          class="categories-scroll flex gap-2 overflow-x-auto pb-1"
          id="categoriesContainer"
        >
          <button
            class="category-pill flex-shrink-0 px-4 py-2 rounded-full text-sm font-semibold transition-all duration-200 bg-red-600 text-white shadow-md shadow-red-200"
            data-category="all"
            aria-pressed="true"
          >
            Todos
          </button>
          <button
            class="category-pill flex-shrink-0 px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 bg-gray-100 text-gray-600 hover:bg-gray-200"
            data-category="balas"
            aria-pressed="false"
          >
            🍬 Balas
          </button>
          <button
            class="category-pill flex-shrink-0 px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 bg-gray-100 text-gray-600 hover:bg-gray-200"
            data-category="chocolates"
            aria-pressed="false"
          >
            🍫 Chocolates
          </button>
          <button
            class="category-pill flex-shrink-0 px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 bg-gray-100 text-gray-600 hover:bg-gray-200"
            data-category="artigos-festa"
            aria-pressed="false"
          >
            🎉 Artigos de Festa
          </button>
          <button
            class="category-pill flex-shrink-0 px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 bg-gray-100 text-gray-600 hover:bg-gray-200"
            data-category="confeitaria"
            aria-pressed="false"
          >
            🧁 Confeitaria
          </button>
        </div>
      </div>
    </div>

    <!-- ==================== GRID DE PRODUTOS ==================== -->
    <main class="max-w-6xl mx-auto px-4 py-6">
      <!-- Indicador de resultados -->
      <div class="flex items-center justify-between mb-5">
        <p class="text-sm text-gray-500" id="resultsCount">
          <span id="resultsNumber">6</span> produtos encontrados
        </p>
        <button
          id="clearFiltersBtn"
          class="text-xs text-red-600 font-medium hover:underline hidden transition-all"
          onclick="clearAllFilters()"
        >
          Limpar filtros
        </button>
      </div>

      <!-- Grid responsivo -->
      <div
        class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-5"
        id="productsGrid"
      >
        <!-- Os cards serão renderizados via JavaScript -->
      </div>

      <!-- Estado vazio -->
      <div
        id="emptyState"
        class="hidden flex-col items-center justify-center py-16 text-center"
      >
        <SearchX class="w-16 h-16 text-gray-300 mb-4" />
        <p class="text-gray-500 text-lg font-medium">
          Nenhum produto encontrado
        </p>
        <p class="text-gray-400 text-sm mt-1">
          Tente ajustar sua busca ou categoria
        </p>
        <button
          onclick="clearAllFilters()"
          class="mt-4 px-5 py-2 bg-red-600 text-white rounded-full text-sm font-medium hover:bg-red-700 transition-colors"
        >
          Ver todos os produtos
        </button>
      </div>
    </main>

    <!-- ==================== MODAL DE DETALHES ==================== -->
    <div
      id="productModal"
      class="modal-overlay hidden fixed inset-0 z-50 flex items-end md:items-center justify-center"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modalTitle"
    >
      <!-- Overlay escuro -->
      <div
        class="absolute inset-0 bg-black/50 backdrop-blur-sm"
        id="modalBackdrop"
      >
      </div>

      <!-- Conteúdo do modal -->
      <div
        class="modal-content relative w-full md:max-w-lg max-h-[90vh] md:max-h-[85vh] bg-white rounded-t-2xl md:rounded-2xl shadow-2xl overflow-y-auto z-10"
      >
        <!-- Botão fechar -->
        <button
          id="closeModalBtn"
          class="absolute top-3 right-3 z-20 w-9 h-9 rounded-full bg-white/90 backdrop-blur-sm shadow-md flex items-center justify-center hover:bg-gray-100 transition-colors"
          aria-label="Fechar detalhes"
        >
          <SearchX class="w-5 h-5 text-gray-500" aria-hidden="true" />
        </button>

        <!-- Imagem do produto -->
        <div
          class="relative w-full aspect-[4/3] bg-gray-100 overflow-hidden rounded-t-2xl md:rounded-t-2xl"
        >
          <img
            id="modalImage"
            src=""
            alt=""
            class="w-full h-full object-cover"
            loading="eager"
          />
          <!-- Badge de atacado sobre a imagem -->
          <div class="absolute bottom-3 left-3 badge-pulse">
            <span
              class="inline-block bg-green-500 text-white text-xs font-bold px-3 py-1.5 rounded-full shadow-lg"
            >
              💰 Atacado disponível
            </span>
          </div>
        </div>

        <!-- Detalhes -->
        <div class="p-5 md:p-6">
          <!-- Nome do produto -->
          <h2
            id="modalTitle"
            class="text-xl md:text-2xl font-bold text-gray-900 leading-tight mb-1"
          >
          </h2>
          <p class="text-xs text-brand-600 font-medium mb-4" id="modalCategory">
          </p>

          <!-- Descrição -->
          <p
            id="modalDescription"
            class="text-gray-600 text-sm leading-relaxed mb-5"
          >
          </p>

          <!-- Preços -->
          <div class="bg-gray-50 rounded-xl p-4 mb-5 border border-gray-100">
            <div class="flex items-center justify-between mb-3">
              <span class="text-sm text-gray-500 font-medium">Preço Varejo</span
              >
              <span
                id="modalPriceRetail"
                class="text-lg font-bold text-gray-800"></span>
            </div>
            <div
              class="flex items-center justify-between pt-3 border-t border-gray-200"
            >
              <div>
                <span class="text-sm text-green-700 font-semibold"
                  >Preço Atacado</span
                >
                <span
                  id="modalWholesaleCondition"
                  class="block text-xs text-gray-400 mt-0.5"></span>
              </div>
              <span
                id="modalPriceWholesale"
                class="text-xl font-extrabold text-green-600"></span>
            </div>
          </div>

          <!-- Botão WhatsApp -->
          <a
            id="whatsappLink"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 w-full py-3.5 bg-green-500 hover:bg-green-600 text-white font-semibold rounded-xl shadow-lg shadow-green-200 transition-all duration-200 hover:shadow-xl hover:shadow-green-300 active:scale-[0.98] text-base"
          >
            <MessageCircle class="w-5 h-5 fill-white" />
            Pedir via WhatsApp
          </a>
          <p class="text-center text-xs text-gray-400 mt-3">
            Resposta rápida • Atendimento personalizado
          </p>
        </div>
      </div>
    </div>

    <!-- CTA  -->
    <section
      class="bg-neutral-200 py-6 md:py-12 flex items-center justify-center"
    >
      <div
        class="text-black text-center max-w-4xl lg:max-w-6xl grid lg:grid-cols-2 mx-auto px-4 py-6 md:py-12"
      >
        <!-- Coluna 1 -->
        <div class="flexcol">
          <h2 class="text-2xl md:text-3xl font-bold mb-4">
            Sua loja vende, sua equipe atende, sua Vitrine trabalha!
          </h2>
          <h4 class="text-xl md:text-2xl font-semibold text-brand-600 mb-4">
            Cansado de perder horas enviando fotos e preços manualmente no
            WhatsApp?
          </h4>
          <p class="text-gray-700 text-md md:text-base mb-6">
            Assim como este protótipo da Candy Shop, sua empresa pode ter uma
            Vitrine Virtual de alta performance que organiza seus pedidos,
            automatiza seu atendimento e coloca seus produtos no topo das buscas
            do Google.
          </p>
          <span class="text-left text-gray-700 text-md md:text-base">
            <ul>
              <li class="flex items-center gap-2 text-gray-700 mb-2">
                <Truck class="w-4 h-4 text-green-600" />
                <span
                  ><strong>Velocidade Máxima:</strong> Site que abre instantaneamente
                  no celular do seu cliente.</span
                >
              </li>
              <li class="flex items-center gap-2 text-gray-700 mb-2">
                <MapPin class="w-4 h-4 text-blue-600" />
                <span
                  ><strong>Gestão Simplificada:</strong> Altere preços e estoque de
                  forma fácil e rápida.</span
                >
              </li>
              <li class="flex items-center gap-2 text-gray-700 mb-2">
                <MessageCircle class="w-4 h-4 text-green-600" />
                <span
                  ><strong>Foco em Vendas:</strong> Receba o pedido já pronto e organizado
                  no seu WhatsApp.</span
                >
              </li>
            </ul>
          </span>
          <p class="text-gray-700 text-md md:text-base">
            Chegou a hora de profissionalizar seu balcão digital.
          </p>
          <a
            href="https://wa.me/5567998951171?text=Ol%C3%A1%2C+gostaria+de+um+or%C3%A7amento!"
            target="_blank"
            rel="noopener noreferrer"
          >
            <button
              class="flex items-center justify-center mx-auto gap-2 mt-4 px-4 py-6 rounded-full text-sm font-semibold transition-all duration-200 bg-brand-600 text-white shadow-md shadow-brand-200 bg-red-600 hover:bg-red-700 cursor-pointer active:scale-[0.98]"
            >
              <Rocket /> QUERO UMA VITRINE ASSIM PARA MINHA LOJA
            </button>
          </a>
        </div>

        <!-- Coluna 2 (Imagem) -->
        <div class="flexcol">
          <picture class="flex items-center justify-center">
            <img
              src="/daniel.png"
              alt="Daniel Carvalho"
              class="w-100 h-auto object-cover"
            />
          </picture>
        </div>
      </div>
    </section>

    <!-- Disclaimer  -->
    <div class="bg-yellow-100 border-l-4 border-yellow-500 p-4 mt-8">
      <div class="max-w-8xl lg:max-w-6xl mx-auto">
        <p class="text-yellow-700 text-sm">
          <strong>Nota de Demonstração:</strong> Esta é uma página de testes desenvolvida
          pela <strong>Suprema</strong>.
        </p>
        <p class="text-sm">
          A "Candy Shop", bem como seus produtos, preços e marcas exibidos, são
          inteiramente fictícios e servem exclusivamente como um protótipo
          funcional para você testar a experiência de navegação, velocidade e
          envio de pedidos. Nenhuma compra real será processada.
        </p>
      </div>
    </div>

    <!-- ==================== RODAPÉ SIMPLES ==================== -->
    <footer class="bg-white border-t border-gray-100 mt-8">
      <div
        class="max-w-6xl mx-auto px-4 py-6 text-center text-sm text-gray-500"
      >
        <p class="font-semibold text-gray-700">Candy Shop</p>
        <p class="mt-1">Atacado & Varejo • Campo Grande, MS</p>
        <p class="mt-3 text-xs text-gray-400">
          © 2026 Candy Shop — Vitrine Digital. Todos os direitos reservados.
        </p>
      </div>
    </footer>
  </body>
</html>

<script is:inline type="text/javascript">
  (function () {
    // ========== DADOS DOS PRODUTOS ==========
    const products = [
      {
        id: 1,
        name: "Pacote de Bala de Goma 1kg",
        category: "balas",
        categoryLabel: "Balas",
        image: "/gominhaGommets.png",
        priceRetail: "R$ 25,00",
        priceWholesale: "R$ 22,00",
        wholesaleCondition: "a partir de 5kg",
        description:
          "Deliciosas balas de goma coloridas nos sabores morango, laranja, limão e uva. Embalagem de 1kg ideal para revenda em supermercados, lojas de conveniência e distribuidoras. Produto de alta qualidade com textura macia e sabor intenso.",
      },
      {
        id: 2,
        name: "Forminhas para Doces (Cento)",
        category: "confeitaria",
        categoryLabel: "Confeitaria",
        image: "/forminhasDoces.png",
        priceRetail: "R$ 12,00",
        priceWholesale: "R$ 10,00",
        wholesaleCondition: "a partir de 10 centos",
        description:
          "Forminhas de papel para doces, brigadeiros e cupcakes. Cores sortidas vibrantes (rosa, azul, amarelo, verde). 100 unidades por pacote. Material resistente, antiaderente e decorativo. Perfeitas para confeitarias e buffets.",
      },
      {
        id: 3,
        name: "Chocolate em Barra Sicao 2kg",
        category: "chocolates",
        categoryLabel: "Chocolates",
        image: "/chocolateSicao.png",
        priceRetail: "R$ 89,00",
        priceWholesale: "R$ 82,00",
        wholesaleCondition: "a partir de 5 unidades",
        description:
          "Chocolate em barra Sicao de 2kg, ideal para confeitaria profissional e revenda. Cobertura saborosa com excelente derretimento. Perfeito para produção de ovos de Páscoa, bombons e sobremesas. Qualidade premium garantida.",
      },
      {
        id: 4,
        name: "Caixa de Bombom Sortido 500g",
        category: "chocolates",
        categoryLabel: "Chocolates",
        image: "/bonbonsGaroto.png",
        priceRetail: "R$ 35,00",
        priceWholesale: "R$ 31,00",
        wholesaleCondition: "a partir de 10 caixas",
        description:
          "Caixa com 500g de bombons sortidos recheados com brigadeiro, beijinho e ninho. Embalagem premium pronta para presente ou revenda imediata. Alta margem de lucro para o varejista.",
      },
      {
        id: 5,
        name: "Açúcar Colorido 1kg",
        category: "confeitaria",
        categoryLabel: "Confeitaria",
        image: "/acucarColorido.png",
        priceRetail: "R$ 18,00",
        priceWholesale: "R$ 15,50",
        wholesaleCondition: "a partir de 8kg",
        description:
          "Açúcar cristal colorido para decoração de bolos, cupcakes e doces finos. Cores vibrantes que não desbotam. 1kg por pacote. Disponível nas cores: rosa, azul, verde, amarelo e vermelho.",
      },
      {
        id: 6,
        name: "Embalagens p/ Brigadeiro (50 un)",
        category: "artigos-festa",
        categoryLabel: "Artigos de Festa",
        image: "/embalagemBrigadeiro.png",
        priceRetail: "R$ 15,00",
        priceWholesale: "R$ 13,00",
        wholesaleCondition: "a partir de 20 pacotes",
        description:
          "Kit com 50 embalagens plásticas transparentes para brigadeiros, beijinhos e docinhos de festa. Inclui fitilho decorativo. Design elegante que valoriza o produto final. Ideal para festas infantis e eventos.",
      },
    ];

    // ========== ELEMENTOS DO DOM ==========
    const productsGrid = document.getElementById("productsGrid");
    const emptyState = document.getElementById("emptyState");
    const resultsNumber = document.getElementById("resultsNumber");
    const clearFiltersBtn = document.getElementById("clearFiltersBtn");
    const searchInput = document.getElementById("searchInput");
    const searchInputMobile = document.getElementById("searchInputMobile");
    const categoryPills = document.querySelectorAll(".category-pill");
    const modal = document.getElementById("productModal");
    const modalBackdrop = document.getElementById("modalBackdrop");
    const closeModalBtn = document.getElementById("closeModalBtn");
    const modalImage = document.getElementById("modalImage");
    const modalTitle = document.getElementById("modalTitle");
    const modalCategory = document.getElementById("modalCategory");
    const modalDescription = document.getElementById("modalDescription");
    const modalPriceRetail = document.getElementById("modalPriceRetail");
    const modalPriceWholesale = document.getElementById("modalPriceWholesale");
    const modalWholesaleCondition = document.getElementById(
      "modalWholesaleCondition",
    );
    const whatsappLink = document.getElementById("whatsappLink");

    // ========== ESTADO ==========
    let activeCategory = "all";
    let searchQuery = "";
    const whatsappNumber = "5567998141785";

    // ========== FUNÇÕES ==========
    function getFilteredProducts() {
      return products.filter((product) => {
        const matchesCategory =
          activeCategory === "all" || product.category === activeCategory;
        const matchesSearch =
          searchQuery === "" ||
          product.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
          product.categoryLabel
            .toLowerCase()
            .includes(searchQuery.toLowerCase());
        return matchesCategory && matchesSearch;
      });
    }

    function renderProducts() {
      const filtered = getFilteredProducts();
      const count = filtered.length;

      // Atualizar contador
      resultsNumber.textContent = count;
      if (activeCategory !== "all" || searchQuery !== "") {
        clearFiltersBtn.classList.remove("hidden");
      } else {
        clearFiltersBtn.classList.add("hidden");
      }

      // Mostrar/esconder grid e empty state
      if (count === 0) {
        productsGrid.classList.add("hidden");
        emptyState.classList.remove("hidden");
        emptyState.classList.add("flex");
      } else {
        productsGrid.classList.remove("hidden");
        emptyState.classList.add("hidden");
        emptyState.classList.remove("flex");
      }

      // Renderizar cards
      productsGrid.innerHTML = filtered
        .map(
          (product, index) => `
                        <div class="product-card bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-lg hover:border-brand-200 transition-all duration-300 cursor-pointer group flex flex-col"
                             onclick="window._openProductModal(${product.id})"
                             style="animation-delay: ${index * 0.06}s;">
                            <!-- Imagem -->
                            <div class="relative aspect-square bg-gray-50 overflow-hidden">
                                <img
                                    src="${product.image}"
                                    alt="${product.name}"
                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-400"
                                    loading="lazy"
                                >
                                <!-- Badge de categoria no canto -->
                                <span class="absolute top-2 left-2 text-[10px] font-semibold bg-white/90 backdrop-blur-sm text-brand-700 px-2 py-0.5 rounded-full shadow-sm">
                                    ${product.categoryLabel}
                                </span>
                                <!-- Ícone de clique -->
                                <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 bg-black/5">
                                    <span class="bg-white/95 backdrop-blur-sm text-brand-600 text-xs font-bold px-3 py-1.5 rounded-full shadow-lg">
                                        Ver Detalhes
                                    </span>
                                </div>
                            </div>
                            <!-- Conteúdo -->
                            <div class="p-3 md:p-4 flex flex-col flex-1">
                                <h3 class="font-semibold text-sm md:text-base text-gray-900 leading-tight mb-2 line-clamp-2 flex-1">
                                    ${product.name}
                                </h3>
                                <div class="space-y-1 mt-auto">
                                    <div class="flex items-center justify-between">
                                        <span class="text-xs text-gray-400">Varejo</span>
                                        <span class="font-bold text-gray-800 text-sm md:text-base">${product.priceRetail}</span>
                                    </div>
                                    <div class="flex items-center justify-between pt-1 border-t border-gray-100">
                                        <span class="text-xs text-green-600 font-medium">Atacado</span>
                                        <span class="font-extrabold text-green-600 text-sm md:text-base">${product.priceWholesale}</span>
                                    </div>
                                </div>
                                <button
                                    class="mt-3 w-full py-2 bg-brand-50 text-brand-700 font-semibold text-xs md:text-sm rounded-lg hover:bg-brand-100 transition-colors flex items-center justify-center gap-1.5"
                                    onclick="event.stopPropagation(); window._openProductModal(${product.id})"
                                >
                                    <Eye class="w-4 h-4" />
                                    Ver Detalhes
                                </button>
                            </div>
                        </div>
                    `,
        )
        .join("");

      // Reinicializar ícones Lucide nos cards recém-renderizados
      if (typeof lucide !== "undefined") {
        lucide.createIcons();
      }
    }

    function openProductModal(productId) {
      const product = products.find((p) => p.id === productId);
      if (!product) return;

      // Preencher dados do modal
      modalImage.src = product.image;
      modalImage.alt = product.name;
      modalTitle.textContent = product.name;
      modalCategory.textContent = product.categoryLabel;
      modalDescription.textContent = product.description;
      modalPriceRetail.textContent = product.priceRetail;
      modalPriceWholesale.textContent = product.priceWholesale;
      modalWholesaleCondition.textContent = product.wholesaleCondition;

      // Gerar link do WhatsApp
      const message = encodeURIComponent(
        `Olá Daniel! Gostaria de saber mais sobre este protótipo, que testei no site da Suprema.`,
      );
      whatsappLink.href = `https://wa.me/5567998951171?text=${message}`;

      // Abrir modal
      modal.classList.remove("hidden");
      modal.classList.add("visible");
      document.body.style.overflow = "hidden";

      // Reinicializar ícones dentro do modal
      if (typeof lucide !== "undefined") {
        lucide.createIcons();
      }
    }

    function closeProductModal() {
      modal.classList.add("hidden");
      modal.classList.remove("visible");
      document.body.style.overflow = "";
    }

    function setActiveCategory(category) {
      activeCategory = category;
      // Atualizar pills visuais
      categoryPills.forEach((pill) => {
        const pillCategory = pill.getAttribute("data-category");
        if (pillCategory === category) {
          pill.classList.remove(
            "bg-gray-100",
            "text-gray-600",
            "hover:bg-gray-200",
          );
          pill.classList.add(
            "bg-brand-600",
            "text-white",
            "shadow-md",
            "shadow-brand-200",
          );
          pill.setAttribute("aria-pressed", "true");
        } else {
          pill.classList.remove(
            "bg-brand-600",
            "text-white",
            "shadow-md",
            "shadow-brand-200",
          );
          pill.classList.add(
            "bg-gray-100",
            "text-gray-600",
            "hover:bg-gray-200",
          );
          pill.setAttribute("aria-pressed", "false");
        }
      });
      renderProducts();
      // Rolar grid para o topo suavemente
      productsGrid.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function clearAllFilters() {
      activeCategory = "all";
      searchQuery = "";
      if (searchInput) searchInput.value = "";
      if (searchInputMobile) searchInputMobile.value = "";
      // Resetar pills
      categoryPills.forEach((pill) => {
        const pillCategory = pill.getAttribute("data-category");
        if (pillCategory === "all") {
          pill.classList.remove(
            "bg-gray-100",
            "text-gray-600",
            "hover:bg-gray-200",
          );
          pill.classList.add(
            "bg-brand-600",
            "text-white",
            "shadow-md",
            "shadow-brand-200",
          );
          pill.setAttribute("aria-pressed", "true");
        } else {
          pill.classList.remove(
            "bg-brand-600",
            "text-white",
            "shadow-md",
            "shadow-brand-200",
          );
          pill.classList.add(
            "bg-gray-100",
            "text-gray-600",
            "hover:bg-gray-200",
          );
          pill.setAttribute("aria-pressed", "false");
        }
      });
      renderProducts();
      productsGrid.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    // ========== EVENT LISTENERS ==========
    // Busca (desktop)
    if (searchInput) {
      searchInput.addEventListener("input", function () {
        searchQuery = this.value.trim();
        // Sincronizar busca mobile
        if (searchInputMobile && searchInputMobile.value !== this.value) {
          searchInputMobile.value = this.value;
        }
        renderProducts();
      });
    }

    // Busca (mobile)
    if (searchInputMobile) {
      searchInputMobile.addEventListener("input", function () {
        searchQuery = this.value.trim();
        // Sincronizar busca desktop
        if (searchInput && searchInput.value !== this.value) {
          searchInput.value = this.value;
        }
        renderProducts();
      });
    }

    // Categorias
    categoryPills.forEach((pill) => {
      pill.addEventListener("click", function () {
        const category = this.getAttribute("data-category");
        setActiveCategory(category);
      });
    });

    // Fechar modal
    closeModalBtn.addEventListener("click", closeProductModal);
    modalBackdrop.addEventListener("click", closeProductModal);

    // Fechar modal com tecla Escape
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && modal.classList.contains("visible")) {
        closeProductModal();
      }
    });

    // Prevenir scroll do body quando modal aberto e o usuário rola dentro do modal
    modal.addEventListener(
      "wheel",
      function (e) {
        const modalContent = modal.querySelector(".modal-content");
        if (modalContent) {
          const atTop = modalContent.scrollTop === 0;
          const atBottom =
            modalContent.scrollTop + modalContent.clientHeight >=
            modalContent.scrollHeight - 1;
          if ((atTop && e.deltaY < 0) || (atBottom && e.deltaY > 0)) {
            // Permite que o evento se propague se estamos no limite
          } else {
            e.stopPropagation();
          }
        }
      },
      { passive: false },
    );

    // Expor função global para os cards
    window._openProductModal = openProductModal;

    // ========== RENDERIZAÇÃO INICIAL ==========
    renderProducts();

    // Inicializar ícones Lucide
    if (typeof lucide !== "undefined") {
      lucide.createIcons();
    }

    console.log("🍬 Candy Shop — Vitrine Digital carregada com sucesso!");
    console.log(
      "📱 " + products.length + " produtos disponíveis para demonstração.",
    );
    console.log("💬 WhatsApp: +" + whatsappNumber);
  })();
</script>

